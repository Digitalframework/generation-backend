# Copy to .env and fill in. .env is git-ignored.
# --- Database (required: the app will not start without DB_PASSWORD) ---------
DB_PASSWORD=hausner

# Optional overrides, defaults shown.
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=GenerationServer
#DB_USER=postgres

# --- Image storage (optional, defaults shown) --------------------------------
# blob = images in the database (GenerationServer)
# gcs  = images in a Cloud Storage bucket (GenerationServerGcs)
#STORAGE_TYPE=blob
#GCS_BUCKET=generation-images
# Set for the local fake-gcs-server emulator; leave unset for real Google Cloud.
#GCS_HOST=http://localhost:4443
#GCS_PROJECT_ID=
